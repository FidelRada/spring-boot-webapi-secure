<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>bo.edu.devsecops</groupId>
    <artifactId>springboot-devsecops-lab</artifactId>
    <version>1.0.0</version>
    <name>springboot-devsecops-lab</name>
    <description>Aplicacion deliberadamente vulnerable para laboratorio local</description>

    <properties>
        <java.version>21</java.version>
        <!-- Versiones gestionadas por el parent que se suben para corregir CVE transitivos
             HIGH/CRITICAL (design.md D7 del change remediate-app-vulnerabilities).
             El parent 3.5.16 trae tomcat 10.1.55 y jackson 2.21.4, todavía vulnerables. -->
        <tomcat.version>10.1.60</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <!-- log4j-api 2.24.3 (Boot 3.5.16): CVE-2026-34479 (CVSS v3 7.5), corregido en 2.25.4. -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- Umbral CVSS de OWASP Dependency-Check. Se expone como propiedad para que
             en el pipeline pueda pasarse -Ddc.failBuildOnCVSS=11 (el plugin no aborta y
             escribe siempre los reportes; el Quality Gate aplica el umbral 7.0).
             En local, sin override, el build falla con CVSS >= 7. -->
        <dc.failBuildOnCVSS>7</dc.failBuildOnCVSS>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Caso didáctico SCA (guía 02): 1.9 tenía CVE-2022-42889 (Text4Shell, CRITICAL);
             1.10.0 es la primera versión corregida. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
        </dependency>

        <!-- Codificación de salida HTML (OWASP Java Encoder) contra XSS reflejado. -->
        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder</artifactId>
            <version>1.5.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- OWASP Dependency-Check: la clave de la NVD se lee de la variable de entorno
                 NVD_API_KEY (secreto de GitHub Actions/Dependabot o variable local); nunca
                 se escribe en este archivo. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <failBuildOnCVSS>${dc.failBuildOnCVSS}</failBuildOnCVSS>
                    <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                    <dataDirectory>${user.home}/.cache/dependency-check-data</dataDirectory>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                        <format>SARIF</format>
                    </formats>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!-- OSS Index migró a Sonatype Guide y exige credenciales; la fuente es la NVD. -->
                    <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                </configuration>
            </plugin>
            <!-- SpotBugs + FindSecBugs (4.9.8.5: 4.10.x exige Maven >= 3.8.9) -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.8.5</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <xmlOutput>true</xmlOutput>
                    <htmlOutput>true</htmlOutput>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.14.0</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>
            <!-- CycloneDX BOM Generator -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>json</outputFormat>
                    <outputName>bom</outputName>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
